<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>ERP Pro</title>

<style>
body { font-family: Arial; background:#0f172a; color:#fff; padding:20px; }
.card { background:#111827; padding:15px; margin-bottom:15px; border-radius:10px; }
input, select { padding:8px; margin:5px; border-radius:5px; border:none; }
button { padding:8px 12px; margin:5px; border:none; border-radius:5px; cursor:pointer; }
.btn { background:#22d3ee; color:#000; font-weight:bold; }
table { width:100%; border-collapse:collapse; margin-top:10px; }
th,td { border:1px solid #333; padding:8px; }
.modal { position:fixed; inset:0; display:none; background:rgba(0,0,0,0.7); justify-content:center; align-items:center; }
.modal-box { background:#fff; color:#000; padding:20px; width:650px; }
</style>
</head>

<body>

<h2>🚀 ERP Pro</h2>

<!-- PRODUCT -->
<div class="card">
<h3>Add Product</h3>
<input id="pname" placeholder="Product">
<input id="pprice" type="number" placeholder="Price">
<input id="pqty" type="number" placeholder="Qty">
<button class="btn" onclick="addProduct()">Add</button>
</div>

<!-- CUSTOMER -->
<div class="card">
<h3>Add Customer</h3>
<input id="cname" placeholder="Customer Name">
<button class="btn" onclick="addCustomer()">Add</button>
</div>

<!-- SALE -->
<div class="card">
<h3>Make Sale</h3>
<select id="sproduct"></select>
<select id="scustomer"></select>
<input id="sqty" type="number" placeholder="Qty">
<button class="btn" onclick="makeSale()">Sell</button>
</div>

<!-- PRODUCT TABLE -->
<div class="card">
<h3>Products</h3>
<table id="ptable"></table>
</div>

<!-- INVOICE -->
<div class="modal" id="invoiceModal">
<div class="modal-box">

<div style="display:flex;justify-content:space-between;">
<h3>🧾 Invoice</h3>
<div>
<button onclick="printInvoice()">Print</button>
<button onclick="closeModal()">X</button>
</div>
</div>

<div id="invoiceContent"></div>

</div>
</div>

<script>

// DATA
let products = [];
let customers = [];
let currentInvoice = null;

// ADD PRODUCT
function addProduct(){
  products.push({
    name:pname.value,
    price:+pprice.value,
    qty:+pqty.value
  });
  pname.value=pprice.value=pqty.value="";
  render();
}

// ADD CUSTOMER
function addCustomer(){
  customers.push({name:cname.value});
  cname.value="";
  render();
}

// RENDER
function render(){
  ptable.innerHTML =
    "<tr><th>Name</th><th>Price</th><th>Qty</th></tr>" +
    products.map(p=>`
      <tr>
        <td>${p.name}</td>
        <td>₹${p.price}</td>
        <td>${p.qty}</td>
      </tr>`).join("");

  sproduct.innerHTML = products.map(p=>`<option>${p.name}</option>`).join("");
  scustomer.innerHTML = `<option>Walk-in</option>` + customers.map(c=>`<option>${c.name}</option>`).join("");
}

// SALE
function makeSale(){
  let name = sproduct.value;
  let customer = scustomer.value || "Walk-in";
  let qty = +sqty.value;

  let p = products.find(x=>x.name===name);
  if(!p || p.qty<qty) return alert("Stock issue");

  p.qty -= qty;

  let subtotal = qty * p.price;
  let cgst = subtotal * 0.09;
  let sgst = subtotal * 0.09;
  let grand = subtotal + cgst + sgst;

  let sale = {
    name, customer, qty,
    subtotal, cgst, sgst, grand,
    date:new Date().toLocaleString()
  };

  showInvoice(sale);
  render();
}

// INVOICE (UPDATED PROFESSIONAL)
function showInvoice(sale){
  currentInvoice = sale;

  let invoiceNo = "INV-" + Date.now();

  let html = `
  <div style="font-family:Arial;">

  <div style="display:flex;justify-content:space-between;border-bottom:2px solid #000;padding-bottom:10px;">
    <div>
      <h2>ERP SaaS Pro</h2>
      <small>GSTIN: 22AAAAA0000A1Z5<br>Phone: 9876543210</small>
    </div>
    <div style="text-align:right;">
      <h3>TAX INVOICE</h3>
      No: ${invoiceNo}<br>
      ${sale.date}
    </div>
  </div>

  <p><b>Customer:</b> ${sale.customer}</p>

  <table>
    <tr><th>Item</th><th>Qty</th><th>Rate</th><th>Total</th></tr>
    <tr>
      <td>${sale.name}</td>
      <td>${sale.qty}</td>
      <td>₹${(sale.subtotal/sale.qty).toFixed(2)}</td>
      <td>₹${sale.subtotal.toFixed(2)}</td>
    </tr>
  </table>

  <p>Subtotal: ₹${sale.subtotal.toFixed(2)}</p>
  <p>CGST (9%): ₹${sale.cgst.toFixed(2)}</p>
  <p>SGST (9%): ₹${sale.sgst.toFixed(2)}</p>
  <h3>Total: ₹${sale.grand.toFixed(2)}</h3>

  <p style="margin-top:30px;">Authorized Signature</p>

  </div>
  `;

  invoiceContent.innerHTML = html;
  invoiceModal.style.display="flex";
}

// PRINT
function printInvoice(){
  let w = window.open("");
  w.document.write(invoiceContent.innerHTML);
  w.print();
}

// CLOSE
function closeModal(){
  invoiceModal.style.display="none";
}

</script>

</body>
</html>
